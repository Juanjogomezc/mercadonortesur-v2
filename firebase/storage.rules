rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública para mostrar las fotos de publicaciones aprobadas.
    // Solo el propietario autenticado puede crear, reemplazar o borrar sus archivos.
    match /listings/{uid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource != null
                            && request.resource.size < 3 * 1024 * 1024
                            && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
