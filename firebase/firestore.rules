rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasProfile() && myProfile().role == 'admin';
    }
    function isApprovedUser() {
      return hasProfile() && myProfile().status == 'approved';
    }

    // ---------- Usuarios ----------
    match /users/{uid} {
      // Cada usuario lee su propio perfil; el admin lee todos
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Al registrarse: solo su propio perfil, siempre como "user" y "pending"
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // El usuario puede editar sus datos pero NO su rol ni su estado.
      // Solo el admin cambia el estado (aprobar / suspender).
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // ---------- Publicaciones ----------
    match /listings/{id} {
      // Público: solo lo aprobado. Dueño: lo suyo. Admin: todo.
      allow read: if resource.data.status == 'approved'
                  || (signedIn() && resource.data.sellerId == request.auth.uid)
                  || isAdmin();

      // Solo cuentas aprobadas publican, y siempre entra "en revisión"
      allow create: if isApprovedUser()
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 2
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;

      // El dueño puede editar y reenviar (vuelve a "pending"), nunca auto-aprobarse.
      // Solo el admin cambia estados (approved / rejected / paused).
      allow update: if isAdmin()
                    || (signedIn() && resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId == resource.data.sellerId
                        && request.resource.data.status == 'pending');

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.sellerId == request.auth.uid);
    }
  }
}
